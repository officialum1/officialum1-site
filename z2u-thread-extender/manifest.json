{
    "manifest_version": 3,
    "name": "Z2U Automation Tool",
    "version": "1.1",
    "description": "Auto-expand threads and auto-sort listings for Z2U.com",
    "permissions": [
        "storage",
        "tabs",
        "windows"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "dashboard.html",
        "default_title": "Z2U Bump & Log Dashboard"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.z2u.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "styles.css"
            ]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}