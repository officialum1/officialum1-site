{
    "manifest_version": 3,
    "name": "OfficialUM1 Sync Master",
    "version": "1.1",
    "description": "Turbo-sync listings from PlayerUp, G2G, and Z2U to the OfficialUM1 dashboard.",
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "cookies",
        "tabs",
        "alarms"
    ],
    "host_permissions": [
        "https://*.playerup.com/*",
        "https://*.g2g.com/*",
        "https://*.z2u.com/*",
        "https://*.officialum1.com/*",
        "http://localhost:3000/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon128.png",
            "32": "icons/icon128.png",
            "48": "icons/icon128.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon128.png",
        "32": "icons/icon128.png",
        "48": "icons/icon128.png",
        "128": "icons/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.playerup.com/*",
                "https://*.g2g.com/*",
                "https://*.z2u.com/*"
            ],
            "js": [
                "content.js"
            ]
        },
        {
            "matches": [
                "https://*.officialum1.com/*",
                "http://localhost:3000/*"
            ],
            "js": [
                "bridge.js"
            ]
        }
    ]
}